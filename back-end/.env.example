# Arcjet — https://docs.arcjet.com/sdk/nest/get-started/
ARCJET_ENV=development
# Site key from https://app.arcjet.com (required)
ARCJET_KEY=
# LIVE | DRY_RUN — DRY_RUN evaluates rules but always allows (safe for local dev)
ARCJET_MODE=DRY_RUN

# PostgreSQL — node-postgres (`pg`)
# Local database created from repo `database/` (PostgreSQL 18 on 127.0.0.1:5432).
DATABASE_URL=postgresql://postgres:PASSWORD@127.0.0.1:5432/app_money

# Better Auth — https://www.better-auth.com/docs/installation
# Generate: npx auth@latest secret
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
# Comma-separated browser origins (Vite + API)
AUTH_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
# true in production; false in local dev is typical
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Auth email (log = no delivery, dev only)
EMAIL_PROVIDER=log

# Seeded admin (npm run db:seed)
ADMIN_NAME=Nima Abbasi
ADMIN_EMAIL=nimaab1992@gmail.com
ADMIN_PASSWORD=
ADMIN_USERNAME=nimaabbasi
# Initial wallet data (default: repo root money-management-backup-2026-10-26.xlsx)
ADMIN_BACKUP_XLSX=
