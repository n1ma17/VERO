# Copy to `.env` and fill secrets before `docker compose up --build`.
# UI: http://localhost:8080  |  API (direct): http://localhost:3000  |  Postgres host: localhost:5433

POSTGRES_PASSWORD=postgres
POSTGRES_PUBLISH_PORT=5433
FRONTEND_PUBLISH_PORT=8080
BACKEND_PUBLISH_PORT=3000

# Better Auth — generate with: npx auth@latest secret
BETTER_AUTH_SECRET=change-me-to-a-long-random-string
# Public origin of the SPA (nginx). Must match the browser URL.
BETTER_AUTH_URL=http://localhost:8080
AUTH_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
# false for local HTTP Docker; true only behind HTTPS
AUTH_SECURE_COOKIES=false
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Arcjet — https://app.arcjet.com (required by the SDK)
ARCJET_KEY=
ARCJET_ENV=development
ARCJET_MODE=DRY_RUN

# Auth email: log (container logs) or smtp
EMAIL_PROVIDER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Optional Nest Observe (leave blank)
OBSERVE_APP_KEY=
OBSERVE_APP_SECRET=
OBSERVE_SERVICE_ID=app-money

# Optional seed (run after up): docker compose exec backend npx tsx scripts/seed.ts
ADMIN_NAME=Nima Abbasi
ADMIN_EMAIL=nimaab1992@gmail.com
ADMIN_PASSWORD=
ADMIN_USERNAME=nimaabbasi
